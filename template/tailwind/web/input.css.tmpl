@import "tailwindcss";
@source "../views/**/*.templ";
{{- if .Shadcn}}
@source "../static/js/shadcn-templ-*.js";
{{- else}}

/* "static" keeps every token in the output, even those only used via var(). */
@theme static {
  --color-background: oklch(0.145 0 0);
  --color-foreground: oklch(0.985 0 0);
  --color-card: oklch(0.205 0 0);
  --color-muted-foreground: oklch(0.708 0 0);
  --color-border: oklch(1 0 0 / 12%);
  --color-primary: oklch(0.72 0.14 215);
  --color-primary-foreground: oklch(0.145 0 0);
}
{{- end}}

@layer components {
  .app { max-width: 56rem; margin: 0 auto; padding: 4rem 1.5rem; }
  .hero { margin-bottom: 2rem; }
  .eyebrow { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-primary); }
  .hero h1 { margin-top: .5rem; font-size: 2.25rem; font-weight: 700; letter-spacing: -.02em; }
  .lead { margin-top: .75rem; color: var(--color-muted-foreground); }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em; }
  .badges { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 2.5rem; padding: 0; list-style: none; }
  .badge { border: 1px solid var(--color-border); border-radius: 9999px; padding: .25rem .75rem; font-size: .8rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
  .panel { border: 1px solid var(--color-border); background: var(--color-card); border-radius: .75rem; padding: 1.25rem; }
  .panel h2 { margin: 0 0 .35rem; font-weight: 600; }
  .panel p { margin: 0 0 .9rem; font-size: .9rem; color: var(--color-muted-foreground); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .btn { cursor: pointer; border: 0; border-radius: .5rem; padding: .45rem .9rem; font-size: .875rem; font-weight: 500; background: var(--color-primary); color: var(--color-primary-foreground); }
  .btn:hover { opacity: .9; }
  .field { flex: 1; min-width: 8rem; border: 1px solid var(--color-border); border-radius: .5rem; padding: .45rem .7rem; font-size: .875rem; background: transparent; color: inherit; }
  .out { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85rem; }
  .log { height: 8rem; margin: 0 0 .75rem; padding: .5rem .75rem; overflow-y: auto; list-style: none; border: 1px solid var(--color-border); border-radius: .5rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8rem; }
}
