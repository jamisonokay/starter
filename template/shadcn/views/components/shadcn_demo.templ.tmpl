package components

import (
	"{{.Module}}/views/ui/button"
	"{{.Module}}/views/ui/card"
)

// ShadcnDemo uses components that shadcn-templ generated into views/ui.
// Add more with: make ui-add c="dialog tabs"
templ ShadcnDemo() {
	@card.Card(card.Props{Class: "w-full"}) {
		@card.Header() {
			@card.Title() {
				shadcn/ui
			}
			@card.Description() {
				Components live in views/ui and are yours to edit.
			}
		}
		@card.Content() {
			<div class="flex flex-wrap gap-2">
				@button.Button() {
					Default
				}
				@button.Button(button.Props{Variant: button.VariantSecondary}) {
					Secondary
				}
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Outline
				}
			</div>
		}
	}
}
